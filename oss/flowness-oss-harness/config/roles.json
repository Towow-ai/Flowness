      "role_id": "judge.reliability-recovery-b",
      "wave": "jury",
      "kind": "judge",
      "dimension": "reliability_recovery",
      "checks": [
        "G2.cancel_timeout",
        "G2.retry_idempotency",
        "G2.resume_recovery"
      ],
      "mission": "Independently inject failures and verify authoritative postconditions, recovery boundaries and no duplicate effects.",
      "output_schema": "jury-report.schema.json"
    },
    {
      "role_id": "judge.benchmark-a",
      "wave": "jury",
      "kind": "judge",
      "dimension": "benchmark",
      "checks": [
        "G3.versioned_eval",
        "G3.baseline_raw_trials",
        "G3.reproducibility"
