        "forbidden_capabilities": ["publish", "network", "credential_use", "external_send", "schedule"],
        "external_effects": "forbidden"
      }
    },
    {
      "role_id": "publisher.stager",
      "wave": "W12",
      "kind": "producer",
      "dimension": "channel_distribution",
      "mission": "Stage a reviewable manual-package assessment from sealed candidate material. It emits package review only, never a send, schedule, credential request, or external action.",
      "output_schema": "content-role-output.schema.json",
      "content_contract": {
        "contract_id": "content-machine/CM-007/v1",
        "input_contract": "sealed_verified_content_graph_v3_and_impact_review_plan",
        "output_kind": "package_review",
        "output_boundary": "role-private/publisher.stager",
        "blindness_required": true,
        "forbidden_mutations": ["claim_registry", "evidence_registry", "candidate_state", "approval_state", "analytics_source_data"],
        "forbidden_capabilities": ["publish", "network", "credential_use", "external_send", "schedule"],
        "external_effects": "forbidden"
      }
    },
    {
      "role_id": "analytics.interpreter",
      "wave": "W12",
      "kind": "producer",
      "dimension": "channel_distribution",
      "mission": "Interpret only sealed analytics observations into typed private notes. It cannot collect data, mutate source observations, publish findings, or promote claims.",
      "output_schema": "content-role-output.schema.json",
      "content_contract": {
        "contract_id": "content-machine/CM-007/v1",
        "input_contract": "sealed_verified_content_graph_v3_and_impact_review_plan",
        "output_kind": "analytics_interpretation",
        "output_boundary": "role-private/analytics.interpreter",
        "blindness_required": true,
        "forbidden_mutations": ["claim_registry", "evidence_registry", "candidate_state", "approval_state", "analytics_source_data"],
        "forbidden_capabilities": ["publish", "network", "credential_use", "external_send", "schedule"],
        "external_effects": "forbidden"
      }
    },
    {
      "role_id": "judge.mechanism-coverage-a",
      "wave": "jury",
      "kind": "judge",
      "dimension": "mechanism_coverage",
      "checks": ["G3.mechanism_coverage"],
      "mission": "Blindly sample the sealed inventory and test whether load-bearing mechanisms, consumers, failures and recovery seams are represented.",
      "output_schema": "jury-report.schema.json"
    },
    {
      "role_id": "judge.mechanism-coverage-b",
      "wave": "jury",
      "kind": "judge",
      "dimension": "mechanism_coverage",
      "checks": ["G3.mechanism_coverage"],
      "mission": "Independently try to prove that a major current mechanism is absent, flattened or supported only by narrative evidence.",
      "output_schema": "jury-report.schema.json"
    },
    {
      "role_id": "judge.truth-claim-a",
      "wave": "jury",
      "kind": "judge",
      "dimension": "truth_claim",
      "checks": ["G3.truth_claims"],
      "mission": "Trace every public claim to scoped, current, independent evidence and reject document-only implementation claims.",
      "output_schema": "jury-report.schema.json"
    },
    {
      "role_id": "judge.truth-claim-b",
      "wave": "jury",
      "kind": "judge",
      "dimension": "truth_claim",
      "checks": ["G3.truth_claims"],
