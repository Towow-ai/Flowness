{
  "schema_version": "agent-role-registry/v1",
  "roles": [
    {
      "role_id": "excavate.intent-planning",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "intent_planning",
      "mission": "Trace intent, interview, concept, consensus and planning through code, events, tests, failures and history. Produce mechanism cards and unknowns.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.task-orchestration",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "task_orchestration",
      "mission": "Trace task graph, dependency, dispatch, multi-agent delegation and the seams with planning and execution.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.event-projection",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "event_projection",
      "mission": "Trace EventLog, envelope, commit gate, projection, watermark and all recovery paths. Sample the event registry exhaustively.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.workspace-concurrency",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "workspace_concurrency",
      "mission": "Trace workspace, worktree, write-set, ownership, lock, lease, retry, idempotency, cancellation and resource governance.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.review-acceptance",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "review_acceptance",
      "mission": "Trace review, finding, verification, fix, retest, acceptance, negative cases and terminal/non-terminal paths.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.context-handoff",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "context_handoff",
      "mission": "Trace handoff, capsule, context, knowledge, judgment and transcript-derived owner decisions without quoting unapproved private text.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.watchers-recovery",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "watchers_recovery",
      "mission": "Trace watcher, sentinel, forward chain, reflow, dead letter, incident, rollback and manual takeover.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.install-fleet",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "install_fleet",
      "mission": "Trace installer, multi-project integration, versions, migrations, server fleet, accounts, quotas, sessions and scheduler.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "excavate.observability-security",
      "wave": "excavation",
      "kind": "producer",
      "dimension": "observability_security",
      "mission": "Trace health, alerting, permissions, secrets, network, production approval and owner authority across normal and failure paths.",
      "output_schema": "mechanism-batch.schema.json"
    },
    {
      "role_id": "challenge.coverage",
      "wave": "coverage-trace",
      "kind": "producer",
      "dimension": "mechanism_coverage",
      "mission": "Object-first blind trace. Consume only the sealed source archive and role-bound coverage sample manifest. Record exact candidate links through definitions and callers without claiming semantic source-chain verification or accessing any mechanism, unknown, drift registry, merge report content, or other trace.",
      "output_schema": "coverage-trace.schema.json",
      "sandbox": "danger-full-access"
    },
    {
      "role_id": "challenge.consumer-chain",
      "wave": "coverage-trace",
      "kind": "producer",
      "dimension": "consumer_chain",
      "mission": "Failure-consumer blind trace. Consume only the sealed source archive and role-bound coverage sample manifest. Record exact candidate links to consumers, failure paths and recovery paths without claiming their semantic relationship or accessing any registry, merge result, or other trace.",
      "output_schema": "coverage-trace.schema.json",
      "sandbox": "danger-full-access"
    },
    {
      "role_id": "challenge.coverage-comparator",
      "wave": "coverage-compare",
      "kind": "producer",
      "dimension": "mechanism_coverage",
      "mission": "Second phase only. Compare sealed blind traces against the bound combined mechanism, unknown and drift registries. Exact source excerpts are candidate links only: never emit source_chain_verified or runtime_verified under this protocol.",
      "output_schema": "coverage-verdict.schema.json",
      "sandbox": "danger-full-access"
    },
    {
      "role_id": "challenge.coverage-adjudicator",
      "wave": "coverage-adjudication",
      "kind": "producer",
      "dimension": "mechanism_coverage",
      "mission": "Adjudicate only comparator or trace conflicts from sealed manifests, traces and registries. Do not add unsampled claims, promote mechanism status, or treat exact excerpts as semantic chain verification.",
      "output_schema": "coverage-verdict.schema.json",
      "sandbox": "danger-full-access"
    },
    {
      "role_id": "challenge.history-simplification",
      "wave": "challenge",
      "kind": "producer",
      "dimension": "history_simplification",
      "mission": "Use git semantic history and failure records to distinguish load-bearing evolved mechanisms from accidental historical baggage.",
      "output_schema": "artifact-bundle.schema.json"
    },
    {
      "role_id": "benchmark.source-level",
      "wave": "benchmark",
      "kind": "producer",
      "dimension": "benchmark",
      "mission": "Benchmark comparable projects at source, test, release, issue and clean-install level. Do not score README rhetoric as implementation.",
      "output_schema": "artifact-bundle.schema.json"
    },
    {
      "role_id": "architecture.atlas",
      "wave": "narrative",
      "kind": "producer",
      "dimension": "architecture",
      "mission": "Generate D0-D9 atlas candidates strictly from accepted mechanism cards. Every diagram names current/target state, truth sources, failure paths and what it cannot prove.",
      "output_schema": "artifact-bundle.schema.json"
    },
    {
      "role_id": "narrative.terminology",
      "wave": "narrative",
      "kind": "producer",
      "dimension": "public_clarity",
      "mission": "Propose terminology only where a real mechanism distinction requires it. Supply one sentence, analogy, failure, diagram brief, demo and falsifier.",
      "output_schema": "artifact-bundle.schema.json"
    },
    {
      "role_id": "content.compiler",
      "wave": "W12",
      "kind": "producer",
      "dimension": "public_clarity",
      "mission": "Compile evidence-bounded professional, developer and public candidate copy from a sealed Content Graph v3. Preserve every limitation and emit typed private drafts only.",
      "output_schema": "content-role-output.schema.json",
      "content_contract": {
        "contract_id": "content-machine/CM-007/v1",
        "input_contract": "sealed_verified_content_graph_v3_and_impact_review_plan",
        "output_kind": "content_draft",
        "output_boundary": "role-private/content.compiler",
        "blindness_required": true,
        "forbidden_mutations": ["claim_registry", "evidence_registry", "candidate_state", "approval_state", "analytics_source_data"],
        "forbidden_capabilities": ["publish", "network", "credential_use", "external_send", "schedule"],
        "external_effects": "forbidden"
      }
    },
    {
      "role_id": "visual_demo.compiler",
      "wave": "W12",
      "kind": "producer",
      "dimension": "visual_demo",
      "mission": "Compile evidence-bounded diagram and demo briefs that expose state change, provenance, failure and recovery. Emit typed private drafts only.",
      "output_schema": "content-role-output.schema.json",
      "content_contract": {
        "contract_id": "content-machine/CM-007/v1",
        "input_contract": "sealed_verified_content_graph_v3_and_impact_review_plan",
        "output_kind": "visual_demo_draft",
        "output_boundary": "role-private/visual_demo.compiler",
        "blindness_required": true,
        "forbidden_mutations": ["claim_registry", "evidence_registry", "candidate_state", "approval_state", "analytics_source_data"],
        "forbidden_capabilities": ["publish", "network", "credential_use", "external_send", "schedule"],
        "external_effects": "forbidden"
      }
    },
    {
      "role_id": "channel.adapter",
      "wave": "W12",
      "kind": "producer",
      "dimension": "channel_distribution",
      "mission": "Adapt sealed, limitation-preserving candidate material into typed channel drafts. It cannot change truth, create a publish action, or use a channel API.",
