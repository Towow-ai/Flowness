        "G2.audit_provenance",
        "G4.quickstart_architecture",
        "G4.upgrade_rollback"
      ],
      "mission": "Verify that D0-D9 views agree with accepted mechanisms, stable identifiers, runtime boundaries and failure paths.",
      "output_schema": "jury-report.schema.json"
    },
    {
      "role_id": "judge.architecture-b",
      "wave": "jury",
      "kind": "judge",
      "dimension": "architecture",
      "checks": [
        "G2.isolation_permission",
        "G2.audit_provenance",
        "G4.quickstart_architecture",
        "G4.upgrade_rollback"
      ],
      "mission": "Independently trace diagram arrows to interfaces, state and evidence, and identify mixed current/target claims.",
      "output_schema": "jury-report.schema.json"
    },
