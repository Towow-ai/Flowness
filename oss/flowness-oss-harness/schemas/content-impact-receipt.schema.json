{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/content-impact-receipt.schema.json",
  "title": "Immutable local review receipt for Content Graph invalidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "authorization", "graph", "changed_node_ids", "affected_node_ids", "required_state", "boundary", "receipt_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "content-impact-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^content-impact-[0-9a-f]{24}$"},
    "authorization": {"type": "string", "const": "local_review_only"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "graph_hash"],
      "properties": {
        "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"},
        "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "changed_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "affected_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_state": {"type": "string", "const": "evidence_bound"},
    "boundary": {"type": "string", "const": "local impact review only; this receipt cannot publish, unpublish, schedule, or mutate source evidence."},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
