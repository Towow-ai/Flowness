{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/candidate-package-surface.schema.json",
  "title": "Private Ledger candidate product-package surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "surface_id", "scope", "authorization", "candidate_package", "candidate_status", "surface_bindings", "release_requirement_gaps", "release_package_eligible", "boundary", "surface_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "candidate-package-surface/v1"},
    "surface_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "scope": {"type": "string", "const": "private_staging_only"},
    "authorization": {"type": "string", "const": "not_authorized"},
    "candidate_package": {"type": "string", "const": "flowness-ledger-core"},
    "candidate_status": {"type": "string", "const": "private_candidate_only"},
    "surface_bindings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    },
    "release_requirement_gaps": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/gap"}
    },
    "release_package_eligible": {"type": "boolean", "const": false},
    "boundary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "surface_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id", "role", "path", "sha256"],
      "properties": {
        "surface_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 180},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "state", "reason"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$"},
        "state": {"type": "string", "const": "not_created_pending_authorized_export"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
