{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/content-consumer-machine-run.schema.json",
  "title": "Local deterministic candidate Content Consumer Machine execution",
  "type": "object",
  "additionalProperties": false,
    "required": ["schema_version", "run_id", "execution_mode", "authorization", "inputs", "producer_records", "review_records", "work_closure", "package_actions", "effect_attestation", "boundary", "run_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "content-consumer-machine-run/v1"},
    "run_id": {"type": "string", "pattern": "^content-consumer-run-[0-9a-f]{24}$"},
    "execution_mode": {"type": "string", "const": "local_deterministic_candidate"},
    "authorization": {"type": "string", "const": "local_review_only"},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["impact_plan", "update_receipt", "package_registry"], "properties": {"impact_plan": {"$ref": "#/$defs/input"}, "update_receipt": {"$ref": "#/$defs/input"}, "package_registry": {"$ref": "#/$defs/input"}}},
    "producer_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "review_records": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/review"}},
    "work_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/closure"}},
    "package_actions": {"type": "array", "items": {"$ref": "#/$defs/packageAction"}},
    "retest": {"$ref": "#/$defs/retest"},
    "effect_attestation": {"$ref": "#/$defs/effects"},
    "boundary": {"type": "string", "const": "local deterministic candidate execution only; records are generated by this bounded harness, not live agents or human semantic review. No source mutation, model call, network, credential use, scheduling, publication, withdrawal, or external send occurred or is authorized."},
    "run_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["source_path", "identity", "content_hash"], "properties": {"source_path": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/sha256"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["work_item_id", "role_id", "record_path", "content_hash", "verification"], "properties": {"work_item_id": {"type": "string", "minLength": 1}, "role_id": {"type": "string", "minLength": 1}, "record_path": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/sha256"}, "verification": {"type": "string", "const": "verified_content_role_output"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["work_item_id", "reviewer_role_id", "review_instance_id", "record_path", "content_hash", "verdict", "independence_scope"], "properties": {"work_item_id": {"type": "string", "minLength": 1}, "reviewer_role_id": {"type": "string", "minLength": 1}, "review_instance_id": {"type": "string", "minLength": 1}, "record_path": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/sha256"}, "verdict": {"type": "string", "enum": ["pass", "fail"]}, "independence_scope": {"type": "string", "const": "separate deterministic evaluator identity and separately sealed result; not a human or model-independence claim"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["work_item_id", "producer_record_hashes", "review_record_hashes", "state"], "properties": {"work_item_id": {"type": "string", "minLength": 1}, "producer_record_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "review_record_hashes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "state": {"type": "string", "enum": ["closed_local_candidate", "blocked_review_failure"]}}},
    "packageAction": {"type": "object", "additionalProperties": false, "required": ["instance_id", "package_hash", "affected_asset_ids", "affected_channel_ids", "related_work_item_ids", "withdrawal_plan", "rebuild_plan", "state"], "properties": {"instance_id": {"type": "string", "pattern": "^channel-package-[0-9a-f]{24}$"}, "package_hash": {"$ref": "#/$defs/sha256"}, "affected_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "affected_channel_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "related_work_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "withdrawal_plan": {"type": "string", "enum": ["mark this private candidate package invalid for any external use; no withdrawal action is executed", "no withdrawal is required because this immutable package instance is outside the computed impact set" ]}, "rebuild_plan": {"type": "string", "enum": ["rebuild only from the current verified graph, then revalidate package bytes and obtain a new local candidate closure", "retain the current immutable package instance; no rebuild is required for this computed impact set"]}, "state": {"type": "string", "enum": ["rebuild_and_withdrawal_plan_ready", "rebuild_blocked_unresolved_review", "not_affected_current_instance"]}}},
    "retest": {"type": "object", "additionalProperties": false, "required": ["rework_artifact", "failed_run", "successor"], "properties": {"rework_artifact": {"type": "object", "additionalProperties": false, "required": ["source_path", "rework_id", "rework_hash"], "properties": {"source_path": {"type": "string", "minLength": 1}, "rework_id": {"type": "string", "pattern": "^content-consumer-rework-[0-9a-f]{24}$"}, "rework_hash": {"$ref": "#/$defs/sha256"}}}, "failed_run": {"type": "object", "additionalProperties": false, "required": ["source_path", "run_id", "run_hash"], "properties": {"source_path": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "pattern": "^content-consumer-run-[0-9a-f]{24}$"}, "run_hash": {"$ref": "#/$defs/sha256"}}}, "successor": {"$ref": "#/$defs/successor"}}},
    "successor": {"type": "object", "additionalProperties": false, "required": ["source_graph", "package_registry", "update_receipt", "predecessor_graph_hash", "predecessor_package_registry_hash"], "properties": {"source_graph": {"type": "object", "additionalProperties": false, "required": ["graph_id", "graph_hash", "candidate_id", "snapshot_id", "version_id", "verification"], "properties": {"graph_id": {"type": "string", "minLength": 1}, "graph_hash": {"$ref": "#/$defs/sha256"}, "candidate_id": {"type": "string", "minLength": 1}, "snapshot_id": {"type": "string", "minLength": 1}, "version_id": {"type": "string", "minLength": 1}, "verification": {"type": "string", "const": "verified_content_graph_v3"}}}, "package_registry": {"type": "object", "additionalProperties": false, "required": ["registry_id", "registry_hash"], "properties": {"registry_id": {"type": "string", "pattern": "^content-package-registry-[0-9a-f]{24}$"}, "registry_hash": {"$ref": "#/$defs/sha256"}}}, "update_receipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_hash"], "properties": {"receipt_id": {"type": "string", "pattern": "^content-update-[0-9a-f]{24}$"}, "receipt_hash": {"$ref": "#/$defs/sha256"}}}, "predecessor_graph_hash": {"$ref": "#/$defs/sha256"}, "predecessor_package_registry_hash": {"$ref": "#/$defs/sha256"}}},
    "effects": {"type": "object", "additionalProperties": false, "required": ["producer_execution", "model_call", "source_material", "publish", "withdrawal", "network", "credential_use", "external_send", "schedule"], "properties": {"producer_execution": {"type": "string", "const": "local_deterministic_candidate_completed"}, "model_call": {"type": "string", "const": "not_attempted"}, "source_material": {"type": "string", "const": "not_mutated"}, "publish": {"type": "string", "const": "not_attempted"}, "withdrawal": {"type": "string", "const": "not_attempted"}, "network": {"type": "string", "const": "not_attempted"}, "credential_use": {"type": "string", "const": "not_attempted"}, "external_send": {"type": "string", "const": "not_attempted"}, "schedule": {"type": "string", "const": "not_attempted"}}}
  }
}
