{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/owner-approval.schema.json",
  "title": "Authenticated owner release approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_id",
    "key_id",
    "candidate_hash",
    "snapshot_id",
    "policy_hash",
    "decision_hash",
    "decision",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "owner-approval/v1"},
    "owner_id": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "candidate_hash": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"$ref": "#/$defs/sha256"},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "decision_hash": {"$ref": "#/$defs/sha256"},
    "decision": {"enum": ["approve", "hold"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value_base64"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "value_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 88,
          "maxLength": 88
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
