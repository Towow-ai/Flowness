{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unsealed local mechanism registry seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "status_ceiling", "source_study", "promotion_requires", "mechanisms", "unknowns", "drift_refs"],
  "properties": {
    "schema_version": {"type": "string", "const": "mechanism-registry-seed/v0"},
    "scope": {"type": "string", "const": "unsealed_local_code_test_study"},
    "status_ceiling": {"type": "string", "const": "experimental"},
    "source_study": {"type": "string", "minLength": 1},
    "promotion_requires": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanism_id", "public_name", "proposed_status", "maturity_ceiling", "study_locator", "proposed_evidence_kinds", "pending_formal_fields", "known_drift_ids", "unresolved_questions", "public_claims"],
        "properties": {
          "mechanism_id": {"type": "string", "minLength": 1},
          "public_name": {"type": "string", "minLength": 1},
          "proposed_status": {"type": "string", "const": "experimental"},
          "maturity_ceiling": {"type": "string", "const": "M2_candidate"},
          "study_locator": {"type": "string", "minLength": 1},
          "proposed_evidence_kinds": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["code", "test", "commit"]}},
          "pending_formal_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "known_drift_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "unresolved_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "public_claims": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "question", "blocking", "next_check"], "properties": {"unknown_id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "next_check": {"type": "string", "minLength": 1}}}},
    "drift_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
