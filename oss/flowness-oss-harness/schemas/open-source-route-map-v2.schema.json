{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/open-source-route-map-v2.schema.json",
  "title": "Flowness open-source route map v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "scope", "bound_sources", "routes", "boundary"],
  "properties": {
    "schema_version": {"const": "flowness-open-source-route-map/v2"},
    "map_id": {"type": "string", "minLength": 1},
    "scope": {"const": "private_staging_only"},
    "bound_sources": {"type": "array", "minItems": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "mechanism_family", "current_disposition", "now_result", "next_route_kind", "maturity_label", "source_publication_policy", "claim_policy", "incremental_value", "retained_boundary", "required_condition_ids"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "mechanism_family": {"type": "string", "minLength": 1},
          "current_disposition": {"enum": ["candidate_pending_minimum_gate", "excluded_from_open_alpha"]},
          "now_result": {"type": "string", "minLength": 1},
          "next_route_kind": {"enum": ["private_research_only", "flowness_open_alpha", "flowness_verified_alpha", "flowness_beta", "broad_channel_launch", "hosted_or_enterprise_default", "exclude_until_rights"]},
          "maturity_label": {"enum": ["current_verified", "experimental", "designed_target", "written_only", "unknown"]},
          "source_publication_policy": {"type": "string", "minLength": 1},
          "claim_policy": {"type": "string", "minLength": 1},
          "incremental_value": {"type": "string", "minLength": 1},
          "retained_boundary": {"type": "string", "minLength": 1},
          "required_condition_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "boundary": {"type": "string", "minLength": 1}
  }
}
