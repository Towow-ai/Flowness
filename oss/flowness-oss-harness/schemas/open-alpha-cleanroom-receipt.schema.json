{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/open-alpha-cleanroom-receipt.schema.json",
  "title": "Flowness Open Alpha clean-room receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "state",
    "source",
    "environment",
    "dependencies",
    "stages",
    "blockers",
    "release_ready",
    "boundary",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "flowness-open-alpha-cleanroom-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["pass", "pass_with_blockers", "failed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "export_id",
        "export_manifest_hash",
        "payload_aggregate_hash",
        "files",
        "bytes"
      ],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "export_id": {"type": "string", "minLength": 1},
        "export_manifest_hash": {"$ref": "#/$defs/sha256"},
        "payload_aggregate_hash": {"$ref": "#/$defs/sha256"},
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "platform",
        "support_coordinate",
        "fresh_venv",
        "network_policy",
        "dependency_source",
        "acceptance_cache",
        "cache_not_part_of_export",
        "single_host_only",
        "existing_venv_inherited",
        "pythonpath_inherited",
        "home_isolated",
        "source_repository_referenced"
      ],
      "properties": {
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "platform": {"type": "string", "minLength": 1},
        "support_coordinate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "system", "machine"],
          "properties": {
            "python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
            "system": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1}
          }
        },
        "fresh_venv": {"type": "boolean"},
        "network_policy": {"type": "string", "minLength": 1},
        "dependency_source": {"type": "string", "minLength": 1},
        "acceptance_cache": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/acceptance_cache"}
          ]
        },
        "cache_not_part_of_export": {"type": "boolean"},
        "single_host_only": {"type": "boolean"},
        "existing_venv_inherited": {"type": "boolean"},
        "pythonpath_inherited": {"type": "boolean"},
        "home_isolated": {"type": "boolean"},
        "source_repository_referenced": {"type": "boolean"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "state",
          "command",
          "exit_code",
          "duration_ms",
          "stdout_bytes",
          "stderr_bytes",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["pass", "fail"]},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout_bytes": {"type": "integer", "minimum": 0},
          "stderr_bytes": {"type": "integer", "minimum": 0},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_id", "detail", "retest_condition"],
        "properties": {
          "blocker_id": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "retest_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "release_ready": {"const": false},
    "boundary": {"type": "string", "minLength": 1},
    "receipt_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "acceptance_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_not_part_of_export",
        "single_host_only",
        "sealed_cross_platform_wheelhouse",
        "resolver_report_sha256",
        "host_matrix",
        "files"
      ],
      "properties": {
        "cache_not_part_of_export": {"type": "boolean"},
        "single_host_only": {"type": "boolean"},
        "sealed_cross_platform_wheelhouse": {"type": "boolean"},
        "resolver_report_sha256": {"$ref": "#/$defs/sha256"},
        "host_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation_name",
            "implementation_version",
            "platform_machine",
            "platform_system",
            "python_full_version",
            "sys_platform"
          ],
          "properties": {
            "implementation_name": {"type": "string", "minLength": 1},
            "implementation_version": {"type": "string", "minLength": 1},
            "platform_machine": {"type": "string", "minLength": 1},
            "platform_system": {"type": "string", "minLength": 1},
            "python_full_version": {"type": "string", "minLength": 1},
            "sys_platform": {"type": "string", "minLength": 1}
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filename", "bytes", "sha256", "source_url"],
            "properties": {
              "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.whl$"},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "source_url": {"type": "string", "pattern": "^https://"}
            }
          }
        }
      }
    }
  }
}
