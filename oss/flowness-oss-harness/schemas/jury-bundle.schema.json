{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/jury-bundle.schema.json",
  "title": "Immutable Flowness jury evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "authorization", "candidate", "policy", "reports", "lineage", "bundle_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "jury-bundle/v1"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "authorization": {"type": "string", "const": "jury_evidence_only"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "policy": {"$ref": "#/$defs/policy"},
    "reports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/report"}},
    "lineage": {"$ref": "#/$defs/lineage"},
    "bundle_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(artifacts|reports|lineage)/[A-Za-z0-9._-]+\\.json$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "snapshot_id", "path", "sha256"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/sha256"}, "path": {"type": "string", "const": "artifacts/candidate.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_version", "path", "sha256"],
      "properties": {"policy_version": {"type": "string", "minLength": 1}, "path": {"type": "string", "const": "artifacts/governance-policy.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "candidate_id", "snapshot_id", "policy_version", "path", "sha256", "signature"],
      "properties": {"report_id": {"$ref": "#/$defs/id"}, "candidate_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/sha256"}, "policy_version": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "signature": {"$ref": "#/$defs/sha256"}}
    },
    "lineageArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "path", "sha256", "self_hash"],
      "properties": {"artifact_type": {"type": "string", "enum": ["blocker_case", "rework_manifest", "successor_retest_attestation"]}, "artifact_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "self_hash": {"$ref": "#/$defs/sha256"}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "origin_candidate_id", "origin_snapshot_id", "artifacts"],
      "properties": {"kind": {"type": "string", "enum": ["initial_jury", "successor_retest"]}, "origin_candidate_id": {"$ref": "#/$defs/id"}, "origin_snapshot_id": {"$ref": "#/$defs/sha256"}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/lineageArtifact"}}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "initial_jury"}}, "required": ["kind"]}, "then": {"properties": {"artifacts": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "successor_retest"}}, "required": ["kind"]}, "then": {"properties": {"artifacts": {"minItems": 3, "maxItems": 3}}}}
      ]
    }
  }
}
