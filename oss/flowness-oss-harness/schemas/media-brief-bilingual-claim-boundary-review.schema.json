{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private media brief bilingual and claim-boundary review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "boundary", "candidate", "source_bindings", "claim_units", "review", "packet_hash"],
  "properties": {
    "schema_version": {"const": "media-brief-bilingual-claim-boundary-review/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "boundary": {"const": "PRIVATE-BOUND-REVIEW-PACKET;HASH-PRESERVATION-ONLY;NO-SEMANTIC-APPROVAL-NO-PUBLISH"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "source_bindings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/binding"}},
    "claim_units": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "status", "limitation_ids"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "status": {"enum": ["experimental", "unknown", "written_only", "designed_target", "current_verified"]}, "limitation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["mechanical_binding_state", "semantic_review_state", "claim_boundary_review_state", "reviewer_slots", "external_release_effect"], "properties": {"mechanical_binding_state": {"const": "bound_unreviewed"}, "semantic_review_state": {"const": "unreviewed"}, "claim_boundary_review_state": {"const": "unreviewed"}, "reviewer_slots": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/reviewer"}}, "external_release_effect": {"const": "no_promotion"}}},
    "packet_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "snapshot_id", "version_id", "capability"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "snapshot_id": {"type": "string", "minLength": 1}, "version_id": {"type": "string", "minLength": 1}, "capability": {"const": "draft"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["binding_id", "path", "sha256"], "properties": {"binding_id": {"enum": ["media_brief", "narrative_manifest", "narrative_en", "narrative_zh_cn"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_role", "status", "review_id"], "properties": {"reviewer_role": {"enum": ["bilingual_semantics", "claim_boundary"]}, "status": {"const": "pending"}, "review_id": {"type": "null"}}}
  }
}
