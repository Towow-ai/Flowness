{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/trusted-owner-keys.schema.json",
  "title": "Trusted owner public-key registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "trusted-owner-keys/v1"},
    "keys": {
      "type": "array",
      "items": {"$ref": "#/$defs/key"},
      "minItems": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nullableDateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "key_id",
        "algorithm",
        "public_key_base64",
        "not_before",
        "not_after",
        "revoked_at"
      ],
      "properties": {
        "owner_id": {"$ref": "#/$defs/id"},
        "key_id": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "ed25519"},
        "public_key_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 44,
          "maxLength": 44
        },
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"},
        "revoked_at": {"$ref": "#/$defs/nullableDateTime"}
      }
    }
  }
}
