{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/benchmark-intake.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "scope", "created_at", "research_transport", "intake_state", "credit_observation", "projects", "comparison_boundary", "intake_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "benchmark-intake/v1"},
    "intake_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"},
    "scope": {"type": "string", "const": "private_staging_only"},
    "created_at": {"type": "string", "const": "2026-08-02T00:00:00+10:00"},
    "research_transport": {"type": "string", "const": "agentkey_primary_source_protocol"},
    "intake_state": {"type": "string", "const": "blocked_external_research_credits"},
    "credit_observation": {"$ref": "#/$defs/credit_observation"},
    "projects": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/project"}},
    "comparison_boundary": {"$ref": "#/$defs/comparison_boundary"},
    "intake_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "credit_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "provider", "remaining_credits", "minimum_discovered_primary_search_credits", "consequence"],
      "properties": {
        "observed_at": {"type": "string", "const": "2026-08-02T00:00:00+10:00"},
        "provider": {"type": "string", "const": "AgentKey"},
        "remaining_credits": {"type": "number", "const": 0.5},
        "minimum_discovered_primary_search_credits": {"type": "number", "const": 1.2},
        "consequence": {"type": "string", "const": "no billed primary-source retrieval executed"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "candidate_repository", "adjacency", "selection_state", "star_status", "source_plan", "evidence_dimensions", "comparison_state", "unresolved"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "candidate_repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "adjacency": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["agent_engineering", "agent_runtime", "agent_orchestration", "agent_evaluation", "stateful_agent_graph"]}},
        "selection_state": {"type": "string", "const": "preexisting_private_seed_candidate_only"},
        "star_status": {"type": "string", "const": "unobserved_not_eligible_for_high_star_claim"},
        "source_plan": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "evidence_dimensions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "enum": ["install", "runtime", "tests_or_evaluations", "recovery_or_failure", "governance_or_evidence"]}},
        "comparison_state": {"type": "string", "const": "pending_primary_evidence"},
        "unresolved": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "url", "expected_primary_evidence", "fetch_state", "fetched_at", "immutable_version"],
      "properties": {
        "surface": {"type": "string", "enum": ["repository", "installation", "runtime_or_architecture", "tests_or_evaluations", "recovery_or_failure", "governance_or_evidence"]},
        "url": {"type": "string", "format": "uri"},
        "expected_primary_evidence": {"type": "string", "minLength": 1},
        "fetch_state": {"type": "string", "const": "not_fetched_credit_blocked"},
        "fetched_at": {"type": "null"},
        "immutable_version": {"type": "null"}
      }
    },
    "comparison_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["external_claims_permitted", "comparative_verdict_permitted", "star_ranking_permitted", "reason"],
      "properties": {
        "external_claims_permitted": {"type": "boolean", "const": false},
        "comparative_verdict_permitted": {"type": "boolean", "const": false},
        "star_ranking_permitted": {"type": "boolean", "const": false},
        "reason": {"type": "string", "const": "each comparator requires official source retrieval plus a pinned version before mechanism comparison"}
      }
    }
  }
}
