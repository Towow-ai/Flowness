{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Ledger demo provenance packet",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "boundary", "candidate", "source_inputs", "demo", "evaluation_output", "unknown_or_pending", "packet_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "demo-provenance-packet/v1"},
    "boundary": {"type": "string", "const": "LOCAL-PRIVATE-CANDIDATE-DEMO-PACKET;NO-RUNTIME-CLEANROOM-RIGHTS-ADOPTION-OR-PUBLICATION-CLAIM"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "snapshot_id", "version_id", "capability"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "snapshot_id": {"type": "string", "minLength": 1}, "version_id": {"type": "string", "minLength": 1}, "capability": {"type": "string", "const": "draft"}}},
    "source_inputs": {"type": "object", "additionalProperties": false, "required": ["content_graph_v2", "content_graph_v3", "generator_refs"], "properties": {"content_graph_v2": {"$ref": "#/$defs/ref"}, "content_graph_v3": {"$ref": "#/$defs/ref"}, "generator_refs": {"type": "object", "additionalProperties": false, "required": ["demo_generator", "scenario_generator", "scenario_test", "evaluation_report_generator"], "properties": {"demo_generator": {"$ref": "#/$defs/ref"}, "scenario_generator": {"$ref": "#/$defs/ref"}, "scenario_test": {"$ref": "#/$defs/ref"}, "evaluation_report_generator": {"$ref": "#/$defs/ref"}}}}},
    "demo": {"type": "object", "additionalProperties": false, "required": ["asset_id", "asset_output", "graph_sources", "scenario_evidence_node_id", "scenario_evidence_hash", "claim_ids", "limitation_ids", "audience_ids", "channel_ids", "draft_state"], "properties": {"asset_id": {"type": "string", "const": "asset.ledger-demo-scenario-pack"}, "asset_output": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "kind"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "kind": {"type": "string", "const": "checked_in_explanatory_output_surface"}}}, "graph_sources": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "type", "content_hash"], "properties": {"node_id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "minLength": 1}}}}, "scenario_evidence_node_id": {"type": "string", "const": "evidence.ledger-wheel-demo.local-001"}, "scenario_evidence_hash": {"type": "string", "minLength": 1}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "limitation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "audience_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "channel_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "draft_state": {"type": "string", "const": "draft"}}},
    "evaluation_output": {"type": "object", "additionalProperties": false, "required": ["output_refs", "state", "claim_ids"], "properties": {"output_refs": {"type": "object", "additionalProperties": false, "required": ["scenario_output_surface", "evaluation_report_schema", "evaluation_report_output_surface"], "properties": {"scenario_output_surface": {"$ref": "#/$defs/ref"}, "evaluation_report_schema": {"$ref": "#/$defs/ref"}, "evaluation_report_output_surface": {"$ref": "#/$defs/ref"}}}, "state": {"type": "string", "const": "no-local-evaluation-receipt-bound-by-this-packet"}, "claim_ids": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}},
    "unknown_or_pending": {"type": "object", "additionalProperties": false, "required": ["runtime_evidence", "external_cleanroom", "rights_and_license", "external_adoption", "publication_authorization"], "properties": {"runtime_evidence": {"type": "string", "const": "unknown"}, "external_cleanroom": {"type": "string", "const": "pending"}, "rights_and_license": {"type": "string", "const": "unknown"}, "external_adoption": {"type": "string", "const": "unknown"}, "publication_authorization": {"type": "string", "const": "not_authorized"}}},
    "packet_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}}
}
