{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowness.dev/schemas/candidate-b-assembly.schema.json",
  "title": "Private Flowness Candidate B assembly",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assembly_id", "authorization", "candidate", "source", "policy", "evidence", "lineage", "assembly_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "candidate-b-assembly/v1"},
    "assembly_id": {"$ref": "#/$defs/id"},
    "authorization": {"type": "string", "const": "private_candidate_assembly_only"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "source": {"$ref": "#/$defs/source"},
    "policy": {"$ref": "#/$defs/policy"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "lineage": {"$ref": "#/$defs/lineage"},
    "assembly_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(artifacts|lineage|evidence)/[A-Za-z0-9._-]+\\.json$|^evidence/[A-Za-z0-9._-]+\\.bin$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "snapshot_id", "artifact"],
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/sha256"}, "artifact": {"$ref": "#/$defs/artifact"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["snapshot", "assembly_manifest"],
      "properties": {"snapshot": {"$ref": "#/$defs/artifact"}, "assembly_manifest": {"$ref": "#/$defs/artifact"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["policy_version", "artifact"],
      "properties": {"policy_version": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/artifact"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["evidence_id", "artifact"],
      "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "artifact": {"$ref": "#/$defs/artifact"}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["blocker_case_id", "blocker_id", "origin_candidate_id", "origin_snapshot_id", "blocker_case", "rework_manifest"],
      "properties": {
        "blocker_case_id": {"$ref": "#/$defs/id"}, "blocker_id": {"type": "string", "pattern": "^(BLK|SYSTEM|UNKNOWN|JURY|MATURITY|CHECK)-[A-Za-z0-9._:-]+$"},
        "origin_candidate_id": {"$ref": "#/$defs/id"}, "origin_snapshot_id": {"$ref": "#/$defs/sha256"},
        "blocker_case": {"$ref": "#/$defs/artifact"}, "rework_manifest": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
